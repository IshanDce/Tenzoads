PORT=5000

# ==========================================
# 1. DATABASE CONFIGURATION
# ==========================================
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/tenzoads
# For MongoDB Atlas (Recommended for production/persistent cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tenzoads?retryWrites=true&w=majority

# ==========================================
# 2. IMAGEKIT CLOUD STORAGE
# ==========================================
# Obtain keys at: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ==========================================
# 3. CORS & CLIENT URLS
# ==========================================
WEBSITE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ==========================================
# 4. AUTHENTICATION & TOKENS
# ==========================================
JWT_SECRET=tenzoads_super_secret_jwt_access_key_2026_xyz
JWT_REFRESH_SECRET=tenzoads_super_secret_jwt_refresh_key_2026_abc
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 5. EMAIL / SMTP
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=hello@yourdomain.com

# ==========================================
# 6. LOCAL UPLOAD FALLBACK & SEED
# ==========================================
UPLOAD_DIR=uploads
SEED_ADMIN_EMAIL=admin@tenzoads.com
SEED_ADMIN_PASSWORD=Admin@123456
